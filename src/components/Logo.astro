---
// Site mark: two peaks read as M, the crossbar turns the second into A. Same drawing as public/favicon.svg.
const { size = 38 } = Astro.props;
---
<svg viewBox="0 0 32 32" width={size} height={size} aria-hidden="true" fill="none">
  <rect width="32" height="32" rx="8" fill="#1fb57a" />
  <path d="M6 23.5 11 9l5 14.5L21 9l5 14.5" stroke="#0b0b0b" stroke-width="3.4" stroke-linejoin="round" stroke-linecap="round" />
  <path d="M18.4 18.5h5.2" stroke="#fff" stroke-width="3" stroke-linecap="round" />
</svg>
